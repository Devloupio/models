# ===========================================
# Mail2Tickets Configuration
# ===========================================

# -------------------------------------------
# Email Configuration
# -------------------------------------------
EMAIL_PROVIDER=imap
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=tickets@example.com
IMAP_PASSWORD=your_email_password
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX

# POP3 Configuration (alternative)
POP3_HOST=pop.gmail.com
POP3_PORT=995
POP3_USERNAME=tickets@example.com
POP3_PASSWORD=your_email_password

# SMTP Webhook (alternative)
SMTP_WEBHOOK_PORT=8025
SMTP_WEBHOOK_HOST=0.0.0.0

# -------------------------------------------
# OpenAI Configuration
# -------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.1
OPENAI_TIMEOUT=30

# Embeddings (optional, for similarity search)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
USE_EMBEDDINGS=false

# -------------------------------------------
# NocoDB Configuration
# -------------------------------------------
NOCODB_BASE_URL=https://your-nocodb-instance.com
NOCODB_API_TOKEN=your-nocodb-api-token
NOCODB_PROJECT_ID=your-project-id
NOCODB_TABLE_TICKETS=tickets
NOCODB_TABLE_COMMENTS=ticket_comments
NOCODB_TABLE_THREADS=email_threads
NOCODB_TABLE_CLIENTS=clients
NOCODB_TABLE_SITES=sites
NOCODB_TABLE_CI=configuration_items
NOCODB_TABLE_CATEGORIES=categories

# -------------------------------------------
# Application Configuration
# -------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/mail2tickets.log
PROCESSING_INTERVAL=60
MAX_EMAILS_PER_BATCH=10
ENABLE_ASYNC_PROCESSING=true

# -------------------------------------------
# Ticket Configuration
# -------------------------------------------
TICKET_NUMBER_PREFIX=TICKET
TICKET_DEFAULT_PRIORITY=medium
TICKET_DEFAULT_STATUS=new
AUTO_ASSIGN_TICKETS=false

# -------------------------------------------
# Thread Detection
# -------------------------------------------
THREAD_DETECTION_METHOD=headers  # headers, subject, hybrid
SUBJECT_TAG_PATTERN=\[TICKET-\d+\]
THREAD_MATCH_THRESHOLD=0.8

# -------------------------------------------
# AI Classification
# -------------------------------------------
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7
AUTO_CATEGORIZE=true
AUTO_PRIORITIZE=true
EXTRACT_ENTITIES=true

# -------------------------------------------
# Security
# -------------------------------------------
API_KEY=your-internal-api-key
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
ENABLE_AUTHENTICATION=true

# -------------------------------------------
# Monitoring & Observability
# -------------------------------------------
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false
TRACING_ENDPOINT=http://jaeger:14268/api/traces

# -------------------------------------------
# Database (PostgreSQL - if direct access needed)
# -------------------------------------------
# Note: NocoDB handles this, but keep for reference
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mail2tickets
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# -------------------------------------------
# Redis (optional, for caching and queues)
# -------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
USE_REDIS_CACHE=false
USE_REDIS_QUEUE=false

# -------------------------------------------
# Development
# -------------------------------------------
DEBUG=false
TESTING_MODE=false
MOCK_OPENAI=false
MOCK_NOCODB=false
